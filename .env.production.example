POSTGRES_PASSWORD=replace-with-a-strong-database-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://draftly.example.com
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

MINIO_ROOT_USER=draftly
MINIO_ROOT_PASSWORD=replace-with-a-strong-object-storage-password
S3_REGION=us-east-1
S3_BUCKET=draftly

DRAFTLY_IMAGE=ghcr.io/warjiang/draftly
DRAFTLY_IMAGE_TAG=sha-replace-with-commit
DRAFTLY_PORT=4173
DRAFTLY_WORKSPACES_DIR=/var/lib/draftly/workspaces
PI_CONFIG_DIR=/opt/draftly/secrets/pi
DRAFTLY_PI_COMMAND=pi
DRAFTLY_PI_PROVIDER=kimi-coding
DRAFTLY_PI_MODEL=k3
DRAFTLY_PI_THINKING=medium
KIMI_API_KEY=
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
TRUST_PROXY=true
