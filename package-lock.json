{
  "name": "draftly",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "draftly",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@draftly/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@draftly/editor": {
      "resolved": "packages/editor",
      "link": true
    },
    "node_modules/@draftly/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@draftly/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/cli": {
      "name": "@draftly/cli",
      "version": "0.1.0",
      "bin": {
        "draftly": "src/index.js"
      }
    },
    "packages/editor": {
      "name": "@draftly/editor",
      "version": "0.1.0"
    },
    "packages/server": {
      "name": "@draftly/server",
      "version": "0.1.0"
    },
    "packages/shared": {
      "name": "@draftly/shared",
      "version": "0.1.0"
    }
  }
}
