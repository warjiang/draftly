{
  "name": "draftly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build --workspace @draftly/editor && node packages/server/src/dev.js",
    "start": "npm run build --workspace @draftly/editor && node packages/server/src/dev.js",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "migrate:drafts": "node packages/server/src/migrate-drafts.js",
    "smoke": "node scripts/smoke-draft.mjs",
    "check": "npm run build && npm test && npm run smoke"
  }
}
