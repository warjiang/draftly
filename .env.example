DATABASE_URL=postgres://draftly:draftly@127.0.0.1:5432/draftly
# Generate a strong secret (>= 32 chars), e.g.:
#   openssl rand -hex 32
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   python3 -c "import secrets; print(secrets.token_hex(32))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:4173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=draftly
S3_ACCESS_KEY_ID=draftly
# Generate an S3-compatible secret key, e.g.:
#   openssl rand -hex 16
#   openssl rand -base64 24
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
S3_SECRET_ACCESS_KEY=replace-with-a-local-secret
S3_FORCE_PATH_STYLE=true
NPM_CONFIG_REGISTRY=https://registry.npmjs.org

# Draftly invokes an authenticated Pi CLI for generation tasks.
DRAFTLY_PI_COMMAND=pi
DRAFTLY_PI_PROVIDER=kimi-coding
DRAFTLY_PI_MODEL=k3
DRAFTLY_PI_THINKING=medium
KIMI_API_KEY=
DRAFTLY_WORKSPACES_DIR=.draftly/workspaces
HOST=127.0.0.1
PORT=4173
TRUST_PROXY=false
